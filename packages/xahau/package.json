{
  "name": "@xrpl-wallet-kit/xahau",
  "version": "0.2.2",
  "description": "Opt-in Xahau protocol runtime for XRPL Wallet Kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.20.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./loader": {
      "types": "./dist/lazy-loader.d.ts",
      "import": "./dist/lazy-loader.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@xrpl-wallet-kit/core": "0.2.2",
    "ripple-keypairs": "^2.0.0",
    "xahau-address-codec": "^5.0.0",
    "xahau-binary-codec": "2.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
