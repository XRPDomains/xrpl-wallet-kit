{
  "name": "@xrpl-wallet-kit/core",
  "version": "0.1.18",
  "description": "Headless XRPL wallet adapter core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "xrpl": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "xrpl": {
      "optional": true
    }
  },
  "devDependencies": {
    "xrpl": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRPDomains/xrpl-wallet-kit.git"
  },
  "homepage": "https://github.com/XRPDomains/xrpl-wallet-kit#readme",
  "bugs": {
    "url": "https://github.com/XRPDomains/xrpl-wallet-kit/issues"
  },
  "keywords": [
    "xrpl",
    "wallet",
    "wallet-adapter",
    "wallet-kit",
    "xrp-ledger",
    "web3"
  ],
  "dependencies": {
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1"
  }
}
